{
  "name": "@hareru/registry",
  "version": "0.4.2",
  "description": "Shared registry types, loaders, and artifacts for Hareru UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hareru-ai/ui",
    "directory": "packages/registry"
  },
  "homepage": "https://github.com/hareru-ai/ui",
  "keywords": ["design-system", "registry", "hareru"],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
