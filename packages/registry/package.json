  },
  "devDependencies": {
    "@hareru/tokens": "workspace:*",
    "@hareru/ui": "workspace:*",
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
