{
  "name": "@hareru/cli",
  "version": "0.6.0",
  "description": "CLI for Hareru UI design system — add components, manage CSS imports",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hareru-ai/ui",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/hareru-ai/ui",
  "keywords": ["cli", "design-system", "hareru", "css"],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "hareru": "./bin/hareru.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": ["dist", "bin", "LICENSE"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@hareru/registry": "workspace:*",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
